DATABASE_URL="postgresql://console:console_dev_password@localhost:5432/console_collector"
JWT_SECRET="change_me_to_a_long_random_string"
FAL_API_KEY="your_fal_ai_key_here"
# Optional: vision model override (defaults to google/gemini-flash-1.5)
# FAL_VISION_MODEL="google/gemini-flash-1.5"
# Optional: enable on-demand IGDB game enrichment for /recognize/game.
# Get credentials from https://api-docs.igdb.com/#account-creation
# IGDB_CLIENT_ID=""
# IGDB_CLIENT_SECRET=""
PORT="3000"
NODE_ENV="development"
